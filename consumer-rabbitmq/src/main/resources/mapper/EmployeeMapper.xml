<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tyz.rabbitmq.mapper.EmployeeMapper">
    <resultMap id="employeeMap" type="com.tyz.rabbitmq.entity.EmployeeVO">
        <id property="empId" column="emp_id" jdbcType="BIGINT"/>
        <result property="empName" column="emp_name" jdbcType="VARCHAR"/>
        <result property="empNo" column="emp_no" jdbcType="VARCHAR"/>
        <result property="deptId" column="dept_id" jdbcType="BIGINT"/>
        <result property="status" column="status" jdbcType="INTEGER"/>
    </resultMap>
    <!--所有列-->
    <sql id="allColumns" >
        emp_id,emp_name,emp_no,dept_id,status
    </sql>
    <!--根据ID查询-->
    <select id="selectById" resultMap="employeeMap">
        SELECT
            <include refid="allColumns"></include>
        FROM t_employee
        WHERE emp_id = #{id,jdbcType=BIGINT}
    </select>
    <!--单个插入-->
    <insert id="insert" useGeneratedKeys="true" keyProperty="empId">
        INSERT INTO t_employee(
            emp_name,
            emp_no,
            dept_id,
            status
        )
        VALUES (
               #{vo.empName,jdbcType=VARCHAR},
               #{vo.empNo,jdbcType=VARCHAR},
               #{vo.deptId,jdbcType=BIGINT},
               #{vo.status,jdbcType=INTEGER}
               )
    </insert>

    <!--批量插入-->
    <insert id="batchSmallInsert" useGeneratedKeys="true" keyColumn="emp_id" keyProperty="empId">
        insert into t_employee (emp_name, emp_no, dept_id, status) values
        <foreach collection="list" item="emp" separator=",">
            (#{emp.empName,jdbcType=VARCHAR},
            #{emp.empNo,jdbcType=VARCHAR},
            #{emp.deptId,jdbcType=BIGINT},
            #{emp.status,jdbcType=INTEGER}
            )
        </foreach>
    </insert>


    <!--单个更新-->
    <update id="update">
        UPDATE t_employee
        SET emp_name=#{vo.empName,jdbcType=VARCHAR},
            emp_no=#{vo.empNo,jdbcType=VARCHAR}
        WHERE emp_id = #{vo.empId,jdbcType=BIGINT}
    </update>
    <!--单个删除-->
    <delete id="delete">
        DELETE FROM t_employee WHERE emp_id = #{id,jdbcType=BIGINT}
    </delete>
    <!--查询所有-->
    <select id="selectAll" resultMap="employeeMap">
        SELECT
        <include refid="allColumns"></include>
        FROM t_employee
    </select>
</mapper>